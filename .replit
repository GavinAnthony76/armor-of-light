modules = ["nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "playwright-driver"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Armor of Light"

[[workflows.workflow]]
name = "Armor of Light"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=\"$REPLIT_DEV_DOMAIN\" npm run dev -- --host 0.0.0.0 --port 5174 --strictPort"
waitForPort = 5174

[[ports]]
localPort = 4174
externalPort = 3000

[[ports]]
localPort = 5174
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20366
externalPort = 3001
